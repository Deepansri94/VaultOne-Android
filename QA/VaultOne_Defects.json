{
  "_meta": {
    "description": "VaultOne QA Defect Repository — Jira-style defect tracking",
    "version": "1.0.0",
    "idPrefix": "VO-BUG-",
    "idFormat": "VO-BUG-XXXX",
    "nextId": 1,
    "severityLevels": ["S1 - Critical", "S2 - High", "S3 - Medium", "S4 - Low", "S5 - Trivial"],
    "priorityLevels": ["P1 - Highest", "P2 - High", "P3 - Medium", "P4 - Low"],
    "complexityLevels": ["Simple", "Medium", "Complex"],
    "statusValues": ["OPEN", "IN PROGRESS", "FIXED", "RETEST", "VERIFIED", "CLOSED", "REJECTED", "DUPLICATE", "WONT FIX"],
    "workflow": "OPEN → IN PROGRESS → FIXED → RETEST → VERIFIED → CLOSED"
  },
  "defects": []
}
